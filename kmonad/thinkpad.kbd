#| Copy this out to easily specify a new layer
(deflayer "name"
  _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _         _
  _    _    _    _    _    _    _    _    _    _    _              _
  _    _    _              _              _    _    _    _    _    _
                                                         _    _    _
)
|#

;; Define the IO parameters of this keyboard
(defcfg
  input  (device-file "/dev/input/by-path/platform-i8042-serio-0-event-kbd")
  output (uinput-sink "KMonad: Thinkpad")
  fallthrough true
)

;; Define layer toggling shortcuts
(defalias
  alm (tap-hold 200 a lsft)
  sls (tap-hold 200 s lmet)  
  dla (tap-hold 200 d lctl)
  flc (tap-hold 200 f lalt)
  jrc (tap-hold 200 j ralt)
  kra (tap-hold 200 k rctl)
  lrs (tap-hold 200 l rmet)  
  srs (tap-hold 200 ; rsft)
  )

;; Define the input-layout coming from the keyboard
(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12  home end  ins  del
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '         ret 
  lsft z    x    c    v    b    n    m    ,    .    /              rsft
  lctl lmet lalt           spc            ralt rmet rctl pgup up   pgdn
                                                         left down rght
)


(deflayer base
  _    _     _     _     _     _    _    _     _     _     _     _    _    _    _    _    _
  _    _     _     _     _     _    _    _     _     _     _     _    _    _
  _    _     _     _     _     _    _    _     _     _     _     _    _    _
  esc  @alm  @sls  @dla  @flc  _    _    @jrc  @kra  @lrs  @srs  _             _
  _    _     _     _     _     _    _    _     _     _     _              _
  _    _    _              _              _    _    _    _    _    _
                                                         _    _    _
)

